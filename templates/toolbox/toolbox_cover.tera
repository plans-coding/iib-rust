<div class="path-toolbox">

    <div class="breadcrumb">
      <!--<img class="icon-color" src="images/frog.svg" />-->
      <div>{{ translation.toolbox.title | default(value="Toolbox") }}</div>
      <img src="images/arrow-right.svg" />

      <a href="?path=toolbox:report" class="breadcrumb-link {% if query_params.path == 'toolbox:report' %}active{% endif %}">{{ translation.toolbox.report | default(value="Report") }}</a>
      <a href="?path=toolbox:input" class="breadcrumb-link {% if query_params.path == 'toolbox:input' %}active{% endif %}">{{ translation.toolbox.input | default(value="Input tool") }}</a>
      {% if settings.Base.Immich == "Enabled" %}
        <a href="?path=toolbox:cover" class="breadcrumb-link {% if query_params.path == 'toolbox:cover' %}active{% endif %}">{{ translation.toolbox.cover | default(value="Cover Photo Sync") }}</a>
      {% endif %}
    </div>

    <script id="immichUrl" type="application/json">{{ settings.Feature.ImmichUrl | safe }}</script>
    <script id="coverPhotoOriginalPaths" type="application/json">{{ cover_photo_original_paths | json_encode | safe }}</script>


    <div class="red-text" id="immich_authorization_status" style="display:block;width:400pt;margin:auto;">

      <div id="immich_authorization_status_NOT_OK" style="display:none;">You need to be logged in to you Immich instance for the synchronization to work, please login at <a class="single-link" target="_blank" href="{{ settings.Feature.ImmichUrl }}">{{ settings.Feature.ImmichUrl }}</a>.</div>

      <div id="immich_authorization_status_OK" style="display:none;">
        You are logged in to you Immich instance at <a class="single-link" target="_blank" href="{{ settings.Feature.ImmichUrl }}">{{ settings.Feature.ImmichUrl }}</a>.<br><br>
        <button class="filter-button" onclick="sync_album_covers('{{ settings.Feature.ImmichUrl }}', '{{ settings.Feature.ImmichCoverAlbumId }}');">Synchronize Immich Cover Photo Album</button><br><br>
        <button class="filter-button" onclick="save_album_covers_ids2OPFS('{{ settings.Feature.ImmichUrl }}', '{{ settings.Feature.ImmichCoverAlbumId }}');">Save Immich Cover Photo Album List to OPFS</button>
      </div>

    </div>

</div>

