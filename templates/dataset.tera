<div style="display:flex;flex-direction:column;">
{% for item in table_list %}
  <div onclick="document.getElementById('sql-input').value = 'SELECT * FROM ' + this.innerHTML + ';';">{{ item.name }}</div>
{% endfor %}
</div>

<div style="display:flex;flex-direction:column;">

</div>

<!--<iframe style="width:100%;height:100%;border:0;display: block;" src="{{ settings.Feature.DatasetEditorUrl }}"></iframe>-->

<textarea id="sql-input"></textarea>
<button onclick="user_run_sql(document.getElementById('sql-input').value)">RUN</button>
<div id="sql-output"></div>
