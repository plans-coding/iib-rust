<style>

  section {max-width:100%!important;width:100%!important;margin:0!important;}
  #iib-foot{display:none;}
  #app {height: 100%;overflow: auto;}

  html, body {
    height: 100%;
    margin: 0;
  }

  #dataset_container {
    display: flex;
    flex-direction: row;
    height: 100%;
  }
  #left-column {
    display: flex;
    flex-direction: column;
    min-width: 150px;
    border-right: 1px solid var(--color-hover-background);
    padding:5pt;
    gap:2pt;
    overflow:auto;
    background-color:var(--color-hover-background);
  }
  #right-column {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
    background-color:var(--color-submenu-background);
  }

  #sql-output {
    flex: 1;            /* take remaining space */
    overflow: auto;     /* scroll if content too big */
  }

  #cellViewer { background-color:var(--color-hover-text);color:var(--color-hover-background);padding:3pt 5pt 3pt 5pt;margin:5pt;border-radius:10pt;font-size:0.8em;max-height:20%;overflow:auto; }


        /* Stretch editor to fit inside its containing div */
        .cm-editor {
            height: 100%;
            width: 100%;
        }

        .tabulator {
          margin:0 5pt 5pt 5pt;
          border: 3pt solid var(--color-filter);
          border-radius:3pt;
        /*
    --tabulator-background-color: red;
    --tabulator-border-color: #444;
    --tabulator-header-background-color: #2e2e44;
    --tabulator-header-color: #fff;
    --tabulator-row-even-background-color: #2a2a3a;
    --tabulator-row-odd-background-color: #222230;
    --tabulator-row-hover-background-color: #3a3a5a;
    --tabulator-row-selected-background-color: #55557a;*/
}

#sql-output-data .tabulator .tabulator-table .tabulator-cell.frozen {
    background-color: #e0e0e0;  /* same as header background */
    color: #000;                /* same as header text color */
    font-weight: bold;           /* optional for emphasis */
    border-right: 1px solid #ccc; /* match header border */
}

.hidden {display:none!important;}

summary {background-color:var(--color-hover-background);color:var(--color-hover-text);padding:2pt;}
details {}

.rotate-animation {
    transform-origin: center;
    animation: spin 2s linear infinite; /* continuous clockwise rotation */
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}

.inactivated-button {background-color:var(--color-hover-background) !important;color:var(--color-hover-text) !important;}

</style>

<script id="sql_output_data" type="application/json"></script>

<div id="dataset_container">

  <div id="left-column">

    <details>
      <summary style="cursor:pointer;">General</summary>
      <div style="background-color:var(--color-background);padding:2pt;border-radius:5pt;">
<div style="cursor:pointer;" data-sql="SELECT
    m.name AS table_name,
    p.name AS column_name
FROM sqlite_master m
JOIN pragma_table_info(m.name) p
WHERE m.type='table';"
            onclick="load_code_editor(this.dataset.sql)">All field names</div>
          </div>
    </details>

    <details open>
      <summary style="cursor:pointer;">Tables</summary>
      <div style="background-color:var(--color-background);padding:2pt;border-radius:5pt;">
      {% for item in table_list %}
      <div style="cursor:pointer;" onclick="load_code_editor('SELECT * FROM ' + this.innerHTML + ';');">{{ item.name }}</div>
      {% endfor %}
      </div>
    </details>

    <details>
      <summary style="cursor:pointer;">Pre-defined queries</summary>
      <div style="background-color:var(--color-background);padding:2pt;border-radius:5pt;">
            {% for item in query_templates %}
      <div style="cursor:pointer;" onclick="load_code_editor(get_predefined_query('{{ item }}'));">{{ item }}</div>
      {% endfor %}
    </details>

    <details>
      <summary style="cursor:pointer;">Custom queries</summary>
      <div style="background-color:var(--color-background);padding:2pt;border-radius:5pt;">
      </div>
    </details>


  </div>

  <div id="right-column">

    <div style="display:flex;padding:5pt;gap:5pt;">
      <button class="filter-button" onclick="document.getElementById('left-column').classList.toggle('hidden');">Toggle Inspection View</button>
      <button style="flex:1;" class="filter-button" id="run_query_button" onclick="user_sql_execution();">Run query <img src="images/run.svg"></button>
      <div style="display:none;" id="loading-overlay"><img src="images/frog.svg" style="width:40px;height:40px;" class="rotate-animation" /></div>
    </div>

	<div style="margin:0 5pt 5pt 5pt;background-color:var(--color-background);border: 3pt solid var(--color-filter);
          border-radius:3pt;"><textarea id="code_editor">SELECT * from bewa_Overview LIMIT 20;</textarea></div>

    <div id="sql-output">
      <div id="sql_output_table"></div>
    </div>

    <div id="cellViewer" contenteditable="true" onbeforeinput="return false"></div>

  </div>

</div>

<!--<iframe style="width:100%;height:100%;border:0;display: block;" src="{{ settings.Feature.DatasetEditorUrl }}"></iframe>-->
