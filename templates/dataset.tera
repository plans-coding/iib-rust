</style>

<div style="display:flex;flex-direction:row;height:100%;">

  <div style="display:flex;flex-direction:column;">
    {% for item in table_list %}
      <div onclick="setEditorText('SELECT * FROM ' + this.innerHTML + ';')">{{ item.name }}</div>
    {% endfor %}
  </div>

  <div style="display:flex;flex-direction:column;flex:1;max-height:100%;overflow:hidden;">
    <div id="sql-input"></div>
    <button onclick="user_run_sql(getEditorText('sql-input'))">RUN</button>
    <div style="overflow:auto;" id="sql-output"><table id="sql-output-table"></table></div>

  </div>

</div>

