<style>
    {% for row in all_overview %}
	@page {{ row.OuterId }} { @bottom-center {content: "#{{ loop.index }}  — {{ row.OuterId }} {{ row.OverallDestination }}";} }
    {% endfor %}

</style>

<div id="print-control">
	<span>Use margin 'Default'.</span> 
	<button class="item-viewer-button black-button" onclick="window.print()">
		Print
	</button>
	<button class="item-viewer-button black-button" onclick="document.querySelector('section.toc')?.insertAdjacentElement('afterend', Object.assign(document.createElement('section'), {className:'blank-page'}))">Add +1 blank page after TOC</button>
	<button class="item-viewer-button black-button" onclick="document.querySelector('section.final-page')?.insertAdjacentElement('beforebegin', Object.assign(document.createElement('section'), {className:'blank-page'}))">Add +1 blank page before final page</button>
</div>

<div id="path-report-output">

<!-- Cover page -->
<section class="title-page">

    <div id="title-page-background"></div>

    <div>
        <img src="static/images/frog.svg" class="frog-logo" />
        <div class="image-mask"></div>
    </div>

    <div class="image-mask report-title">
        <h1>{{ translation.report.registerOfTrips | default(value="Register of Trips") }}</h1>
    </div>

    <div class="query-param">
        {{ title_string }}
    </div>
</section>



<!-- Blank page -->
<section class="blank-page"></section>



<!-- Table of Contents -->
<section class="toc">
    <h1>{{ translation.menu.overview | default(value='Overview') }}</h1>

    {% set_global currentYear = "" %}
    {% set_global currentTrip = "" %}

    {% for row in all_overview %}
        {% if row.InnerId != currentTrip %}
            <div class="toc-row">
                <div class="year-column">
                    {% if row.TripYear != currentYear %}
                        {{ row.TripYear }}
                        {% set_global currentYear = row.TripYear %}
                    {% endif %}
                </div>

                <div>
                    <a class="link" href="#{{ row.InnerId }}" data-trip-domain="{{row.TripDomain}}">
                        <div class="id-wrapper">
                            <div class="themeBgColor id-badge" data-trip-domain="{{row.TripDomain}}">
                                {{ row.OuterId }}
                            </div>
                        </div>
                        <span class="destination-label">{{ row.OverallDestination }}</span>
                        &nbsp;&nbsp;#<span class="page-number">{{ loop.index }}</span>
                    </a>
                </div>
            </div>

            {% set_global currentTrip = row.InnerId %}
        {% endif %}
    {% endfor %}
</section>


{% set_global currentTrip = "" %}
{% set_global currentTripCount = 0 %}

{% for row in all_events %}
    {% if loop.first or row.OuterId != currentTrip %}
        {% if not loop.first %}
                </div>
            </section>
        {% endif %}

	{% set cover_photo_id = all.cover_photos_list | get(key=row.OuterId, default="NO") %}
        <section class="trip-section" id="{{ row.InnerId }}" style="page:{{ row.OuterId }}; --cover-url: url('{{ cover_photo_id | safe }}?size=preview');">
	
	<div class="trip-cover" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
		<div class="trip-cover-header">
                    {{ all_overview[currentTripCount].OuterId }}
                    {{ translation.trip.to | default(value="to") }}
                    {{ all_overview[currentTripCount].OverallDestination }}
		</div>
		<div class="trip-cover-sub-header">
                    {{ all_overview[currentTripCount].TripDescription }}
		</div>
	</div>

            <div class="trip-overview" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">

                <div class="trip-layout">
                    <div class="column-stack">
                        <div class="row-flex">
                            <div class="trip-details-container">
                                <label class="trip-details-label">
                                    {{ translation.trip.departureDate | default(value="Departure Date") }}
                                </label>
                                <div class="trip-details-field" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
                                    {{ all_overview[currentTripCount].DepartureDate }}
                                </div>
                            </div>

                            <div class="trip-details-container">
                                <label class="trip-details-label">
                                    {{ translation.trip.returnDate | default(value="Return Date") }}
                                </label>
                                <div class="trip-details-field" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
                                    {{ all_overview[currentTripCount].ReturnDate }}
                                </div>
                            </div>

                            <div class="trip-details-container">
                                <label class="trip-details-label">
                                    {{ translation.trip.numberOfDays | default(value="Days Count") }}
                                </label>
                                <div class="trip-details-field" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
                                    {{ all_overview[currentTripCount].NumberOfDays }}
                                </div>
                            </div>
                        </div>

                        <div class="row-flex">
                            <div class="trip-details-container">
                                <label class="trip-details-label">
                                    {{ translation.trip.participantGroup | default(value="Participant Group") }}
                                </label>
                                <div class="trip-details-field" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
                                    {{ all_overview[currentTripCount].ParticipantGroup }}
                                </div>
                            </div>

                            <div class="trip-details-container">
                                <label class="trip-details-label">
                                    {{ translation.trip.outerId | default(value="ID") }}
                                    ({{ all_overview[currentTripCount].InnerId }})
                                </label>
                                <div class="trip-details-field" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
                                    {{ all_overview[currentTripCount].OuterId }}
                                    <span class="small-muted-text"></span>
                                </div>
                            </div>

                            <div class="trip-details-container">
                                <label class="trip-details-label">
                                    {{ translation.trip.numberOfCountries | default(value="Countries Count") }}
                                </label>
                                <div class="trip-details-field" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
                                    {% if all_borders_countries[currentTripCount].UniqueCountries %}
                                        {{ all_borders_countries[currentTripCount].UniqueCountries | split(pat=", ") | length }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="column-stack">
                            <div class="trip-details-container">
                                <label class="trip-details-label">
                                    {{ translation.trip.uniqueCountries | default(value="Unique Countries") }}
                                </label>
                                <div class="trip-details-field" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
                                    {% if all_borders_countries[currentTripCount].UniqueCountries %}
                                        {{ all_borders_countries[currentTripCount].UniqueCountries }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </div>
                            </div>

                            <div class="trip-details-container">
                                <label class="trip-details-label">
                                    {{ translation.trip.overallRoute | default(value="Overall Route") }}
                                </label>
                                <div class="trip-details-field" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
                                    {{ all_borders_countries[currentTripCount].OverallRoute | default(value="-") }}
                                </div>
                            </div>

                            <div class="trip-details-container">
                                <label class="trip-details-label">
                                    {{ translation.trip.countryTripMovements | default(value="Country Trip Movements") }}
                                </label>
                                <div class="trip-details-field" data-trip-domain="{{ all_overview[currentTripCount].TripDomain }}">
                                    {{ all_borders_countries[currentTripCount].AllBorderCrossings | default(value="-") }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="display:none">
                        <div id="map-{{ row.InnerId }}" class="map-frame"></div>
                    </div>
                </div>
            </div>

            <div class="days" data-trip-domain="{{ row.TripDomain }}">
                {% set_global currentTrip = row.OuterId %}
                {% set_global currentTripCount = currentTripCount + 1 %}
    {% endif %}

    <div class="day">
        <div class="day-left">
            <div class="day-event">
                {{ row.Events }}
            </div>

            <div class="day-foot" data-trip-domain="{{ row.TripDomain }}">
                <div class="day-label">
                    <div class="day-icon" data-trip-domain="{{ row.TripDomain }}">
                        {{ row.DayNumber }}
                    </div>
                    {{ row.Weekday | default(value="") }}
                    {{ row.Date }}
                </div>
                &nbsp;
                <a class="acc-link" target="_blank" href="{{ settings.Other.ExternalMapProvider }}{{ row.AccommodationCoordinates }}">
                    <div class="acc-icon" data-trip-domain="{{ row.TripDomain }}"></div>
                    <span class="acc-text">
                        {{ row.Accommodation }}
                        –
                        {{ row.AccommodationCountryFlag }}
                        {{ row.AccommodationCountry }}
                        –
                        {{ row.AccommodationCoordinates }}
                        {{ row.AccommodationCoordinateAccuracy | default(value="") }}
                    </span>
                </a>
            </div>
        </div>
    </div>

    {% if loop.last %}
            </div>
        </section>
    {% endif %}
{% endfor %}

<!-- Last page -->
<section class="final-page">
  <div>
    <img src="static/images/frog.svg" style="height:50pt;" />
  </div>
  <div>
    <span class="immer-in-font-uc">Immer in</span>&nbsp;<span class="bewegung-font-uc">Bewegung</span>
  </div>
  <div>
    {{ backside_string }}
  </div>
</section>

</div>
