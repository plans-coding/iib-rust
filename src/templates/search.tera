<div class="component-breadcrumb">
  <div class="breadcrumb">
    <img class="widescreen icon-color" src="static/images/frog.svg" />
    <div class="widescreen">{{ translation.menu.search | default(value="Search") }}</div>
    <img class="widescreen" src="static/images/arrow-right.svg" />
    <div class="breadcrumb-link active">{{ all.query_params.path | split(pat=":") | last }}</div>
  </div>
</div>

<div id="path-search">

  <details open class="search">
      <summary>{{ translation.search.trips | default(value="Trips") }} ({{ search_trip | length }})</summary>
      <table class="table" style="width:100%;">
        {% set tripCount = search_trip | length %}
        {% if tripCount == 0 %}
          <tr>
            <td class="text-center align-middle p-3 icon-color">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-calendar2-x" viewBox="0 0 16 16">
                <path d="M6.146 8.146a.5.5 0 0 1 .708 0L8 9.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 10l1.147 1.146a.5.5 0 0 1-.708.708L8 10.707l-1.146 1.147a.5.5 0 0 1-.708-.708L7.293 10 6.146 8.854a.5.5 0 0 1 0-.708"/>
                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M2 2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z"/>
                <path d="M2.5 4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H3a.5.5 0 0 1-.5-.5z"/>
              </svg>
            </td>
          </tr>
        {% endif %}

        {% for trip in search_trip %}
          <tr>
            <td class="text-start">
              <a href="?path=trip:{{ trip.OuterId }}" class="iib-search-domain" data-trip-domain="{{ trip.DomainAbbreviation }}">

                  {{ trip.OuterId }} {{ trip.OverallDestination }}

              </a>
            </td>
            <td class="text-start align-middle">
              {{ trip.TripDescription }} {{ trip.DepartureDate }} {{ translation.trip.to | default(value="until")  }} {{ trip.ReturnDate }}
            </td>
            <td>
              <div data-participant-group="participant-group">{{ trip.ParticipantGroup }}</div>
            </td>
          </tr>
        {% endfor %}
      </table>
  </details>

  <br />
  <details open class="search">
      <summary>{{ translation.search.dayNotes | default(value="Day Notes") }} ({{ search_event | length }})</summary>


      <div class="days">
          {% for day in search_event %}
            <div class="day" data-trip-domain="{{ day.TripDomain }}">
              <div class="day-left">
                <div class="day-event">
                    <div class="day-event-media">
                      {% if settings.Photos.Immich == "Enabled" and day.OuterId not in settings.Other.ExcludeDayPhotos %}
                          <a class="to-image-viewer" href="?path=images:{{ day.OuterId }}:{{ day.Date }}" target="_blank">
                              <button type="button" class="item-viewer-button filter-button" data-trip-domain="{{ day.TripDomain }}">
                                  <img src="static/images/photos.svg" />
                              </button>
                          </a>
                      {% endif %}

                      {# for item in trip_extension_reference_items %}
                        {% if item.Date == day.Date %}
                          {% if item.ExtensionType == "Diary" %}
                            <button class="item-viewer-button" onclick="const img=document.getElementById('img_{{ loop.index }}');if(!img.src) img.src=img.dataset.src;document.getElementById('dlg_{{ loop.index }}').showModal();" type="button" data-trip-domain="{{ day.DomainAbbreviation }}">
                              <img src="static/images/diary.svg" />
                            </button>
                          {% elif item.ExtensionType == "Passport" %}
                            <button class="item-viewer-button" onclick="const img=document.getElementById('img_{{ loop.index }}');if(!img.src) img.src=img.dataset.src;document.getElementById('dlg_{{ loop.index }}').showModal();" type="button" data-trip-domain="{{ day.DomainAbbreviation }}">P</button>
                          {% endif %}

                          <dialog class="item-viewer" id="dlg_{{ loop.index }}" onclick="this.close();">
                            <div class="item-viewer-filename">{{ item.Filepath | split(pat="/") | last }}</div>
                            <img id="img_{{ loop.index }}" data-src="{{ item.Filepath }}" title="{{ item.Filepath }}">
                          </dialog>
                        {% endif %}
                      {% endfor #}
                    </div>

                    <a class="iib-search-domain" href="?path=trip:{{ day.OuterId }}" style="text-decoration:none;display:inline-block;margin:2pt;" data-trip-domain="{{ day.DomainAbbreviation }}">{{ day.OuterId }}</a>
                    <span class="day-label">{{ day.Weekday | default(value="") }} <span class="iib-search-date">{{ day.Date }}</span></span><br>
                    {{ day.Events }}

                </div>

                <div class="day-foot" data-trip-domain="{{ day.TripDomain }}">

                  {#<div class="day-label"><div class="day-icon" data-trip-domain='{{ day.TripDomain }}'>{{ day.DayNumber }}</div> {{ day.Weekday | default(value="") }} {{ day.Date }}</div>&nbsp;#}

                  <a class="acc-link" target="_blank" href="{{ settings.Other.ExternalMapProvider }}{{ day.AccommodationCoordinates }}" data-trip-domain="{{ day.TripDomain }}">
                      <div class="acc-icon" data-trip-domain='{{ day.TripDomain }}'></div>
                      <span class="acc-text">{{ day.Accommodation }} – {#{ day.AccommodationCountryFlag }#} {{ day.AccommodationCountry }} – {{ day.AccommodationCoordinates }} {{ day.AccommodationCoordinateAccuracy | default(value="") }}</span>
                  </a>

                </div>

              </div>
            </div>
          {% endfor %}
        </div>

  </details>

</div>
