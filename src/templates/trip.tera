<style>

#iib-foot {display:none;}

{% set cover_photo_id = all.cover_photos_list | get(key=trip_summary[0].OuterId, default="") %}

:root {
  {% if cover_photo_id != "" %}
      --cover-photo-url: url('{{ cover_photo_id | safe }}');
  {% else %}
      --cover-photo-url: none;
  {% endif %}
}

</style>

<div id="path-trip">

  <div id="trip-container">
	<div id="trip-container-cover"><img src="{{ cover_photo_id | safe }}"></div>
	<div id="trip-container-content">
	  {% set_global theme_color = "" %}
	  {% for item in common_trip_domains %}
	      {% if item.DomainAbbreviation == trip_summary[0].DomainAbbreviation %}
	          {% set_global theme_color = item.Color %}
	      {% endif %}
	  {% endfor %}

	<div style="position:fixed;right:10pt;bottom:10pt;" id="trip-utilities">

	          <div class="clickable-icon" onclick="document.getElementById('menu').style.display = (document.getElementById('menu').style.display === 'none' ? 'block' : 'none')">

					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
					class="bi bi-arrows-collapse" viewBox="0 0 16 16">
					<path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13A.5.5 0 0
					1 1 8m7-8a.5.5 0 0 1 .5.5v3.793l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0
					1-.708 0l-2-2a.5.5 0 1 1 .708-.708L7.5 4.293V.5A.5.5 0 0 1 8 0m-.5 11.707-1.146
					1.147a.5.5 0 0 1-.708-.708l2-2a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5
					11.707V15.5a.5.5 0 0 1-1 0z"/>
					</svg>

	          </div>

<!--
	          <div class="clickable-icon" onclick="toggle_trip_side_navigator()">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-list-ul" viewBox="0 0 16 16">
				<path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m-3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
				</svg>
	          </div>
-->
	          <div class="clickable-icon" onclick="document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen()">

			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrows-fullscreen" viewBox="0 0 16 16">
				<path fill-rule="evenodd" d="M5.828 10.172a.5.5 0 0 0-.707 0l-4.096 4.096V11.5a.5.5 0 0 0-1 0v3.975a.5.5 0 0 0 .5.5H4.5a.5.5 0 0 0 0-1H1.732l4.096-4.096a.5.5 0 0 0 0-.707m4.344 0a.5.5 0 0 1 .707 0l4.096 4.096V11.5a.5.5 0 1 1 1 0v3.975a.5.5 0 0 1-.5.5H11.5a.5.5 0 0 1 0-1h2.768l-4.096-4.096a.5.5 0 0 1 0-.707m0-4.344a.5.5 0 0 0 .707 0l4.096-4.096V4.5a.5.5 0 1 0 1 0V.525a.5.5 0 0 0-.5-.5H11.5a.5.5 0 0 0 0 1h2.768l-4.096 4.096a.5.5 0 0 0 0 .707m-4.344 0a.5.5 0 0 1-.707 0L1.025 1.732V4.5a.5.5 0 0 1-1 0V.525a.5.5 0 0 1 .5-.5H4.5a.5.5 0 0 1 0 1H1.732l4.096 4.096a.5.5 0 0 1 0 .707"/>
				</svg>

	          </div>
	</div>

	{# Modern trip navigation #}
	  <div id="trip_navigation">

		<a href="?path=trip:{{ trip_previous[0].OuterId }}" data-trip-domain="{{ trip_summary[0].TripDomain }}">
	          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-left" viewBox="0 0 16 16">
	            <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/>
	          </svg>
	      </a>

	      <a href="?path=trip:{{ trip_next[0].OuterId }}" data-trip-domain="{{ trip_summary[0].TripDomain }}">
	          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-right" viewBox="0 0 16 16">
	            <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/>
	          </svg>
	      </a>

	  </div>


	  <details open class="trip" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	    <summary data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}" class="trip-summary-header">
	      <div><b>{{ trip_summary[0].OuterId }} {{ translation.trip.to | default(value="to") }}
	      {{ trip_summary[0].OverallDestination }}</b></div>
	      <div>{{ trip_summary[0].TripDescription }}</div>
	    </summary>

	    <div class="trip-layout">
	      <div class="column-stack">

	        <div class="row-flex">
	          <div class="trip-details-container">
	            <label class="trip-details-label">{{ translation.trip.departureDate | default(value="Departure Date") }}</label>
	            <div class="trip-details-field" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">{{ trip_summary[0].DepartureDate }}</div>
	          </div>

	          <div class="trip-details-container">
	            <label class="trip-details-label">{{ translation.trip.returnDate | default(value="Return Date") }}</label>
	            <div class="trip-details-field" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">{{ trip_summary[0].ReturnDate }}</div>
	          </div>

	          <div class="trip-details-container">
	            <label class="trip-details-label">{{ translation.trip.numberOfDays | default(value="Days Count") }}</label>
	            <div class="trip-details-field" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">{{ trip_summary[0].NumberOfDays }}</div>
	          </div>
	        </div>

	        <div class="row-flex">
	          <div class="trip-details-container">
	            <label class="trip-details-label">{{ translation.trip.participantGroup | default(value="Participant Group") }}</label>
	            <div class="trip-details-field" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">{{ trip_summary[0].ParticipantGroup }}</div>
	          </div>

	          <div class="trip-details-container">
	            <label class="trip-details-label">{{ translation.trip.outerId | default(value="ID") }} ({{ trip_summary[0].InnerId }})</label>
	            <div class="trip-details-field" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	              {{ trip_summary[0].OuterId }} <span class="small-muted-text"></span>
	            </div>
	          </div>

	          <div class="trip-details-container">
	            <label class="trip-details-label">{{ translation.trip.numberOfCountries | default(value="Countries Count") }}</label>
	            <div class="trip-details-field" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	              {% if trip_unique_countries | length > 0 %}{{ trip_unique_countries | length }}{% else %}-{% endif %}
	            </div>
	          </div>
	        </div>

	        <div class="column-stack">
	          <div class="trip-details-container">
	            <label class="trip-details-label">{{ translation.trip.uniqueCountries | default(value="Unique Countries") }}</label>
	            <div class="trip-details-field" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	              {% if trip_unique_countries | length > 0 %}
	                {% for country in trip_unique_countries %}
	                  {{ country.Flag }}&nbsp;{{ country.Country }}{% if not loop.last %}, {% endif %}
	                {% endfor %}
	              {% else %} - {% endif %}
	            </div>
	          </div>

	          <div class="trip-details-container">
	            <label class="trip-details-label">{{ translation.trip.overallRoute | default(value="Overall Route") }}</label>
	            <div class="trip-details-field" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	              {{ trip_border_crossings[0].OverallRoute | default(value="-") }}
	            </div>
	          </div>

	          <div class="trip-details-container">
	            <label class="trip-details-label">{{ translation.trip.countryTripMovements | default(value="Country Trip Movements") }}</label>
	            <div class="trip-details-field" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	              {{ trip_border_crossings[0].AllBorderCrossings | default(value="-") }}
	            </div>
	          </div>

	          {% if settings.Photos.Immich == "Enabled" %}
	              {% if trip_immich_desc_search[0].ImmichDescSearch %}
	                    <a class="to-image-viewer" href='{{ settings.Photos.ImmichUrl }}search?query=%7B"description"%3A"(IIB-{{ trip_summary[0].OtherId }})"%7D#search-chips' target="_blank">
	                        <button type="button" class="item-viewer-button dark-button full-width-button" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	                            <img src="static/images/photos.svg" />
	                            {{ trip_immich_desc_search[0].ImmichDescSearch }}
	                        </button>
	                    </a>
	              {% elif trip_immich_album_name[0].ImmichAlbumName %}
	                    <a class="to-image-viewer" data-album="{{ trip_immich_album_name[0].ImmichAlbumName }}" onclick="get_album_id_from_name('{{ settings.Photos.ImmichUrl }}', this.dataset.album).then(function(id){window.open('/albums/'+id)})" target="_blank">
	                        <button type="button" class="item-viewer-button dark-button full-width-button" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	                            <img src="static/images/photos.svg" class="vertical-align-middle" />
	                            {{ trip_immich_album_name[0].ImmichAlbumName }}
	                        </button>
	                    </a>
	              {% endif %}
	          {% endif %}
	          
	          {% for movie in trip_extension_movie %}
	              <a href="{{ movie.MovieUrl }}" target="_blank">
	                <button class="item-viewer-button dark-button full-width-button">
	                  <img src="static/images/photos.svg" />
	                  {{ movie.MovieId }}
	                </button>
	              </a>
	          {% endfor %}
	        </div>
	      </div>

	      <div><div id="map" class="map-frame"></div></div>
	      <div id="map-pin-data" data-trip-map-overall='{{ trip_map_pins_overall | json_encode }}' data-trip-map-accommodation='{{ trip_map_pins_accommodation | json_encode | escape }}' data-theme-color="{{ theme_color }}"></div>
	    </div>
	  </details>

	  {% if trip_events %}
	  <div class="days" data-trip-domain="{{ trip_summary[0].TripDomain }}">
	    {% for day in trip_events %}
	      <div class="day" data-trip-domain="{{ trip_summary[0].TripDomain }}">
	        <div class="day-left">
	          <div class="day-event">
	              <div class="day-event-media">
	                {% if settings.Photos.Immich == "Enabled" and day.OuterId not in settings.Other.ExcludeDayPhotos %}
	                    <a class="to-image-viewer" href="?path=images:{{ day.OuterId }}:{{ day.Date }}" target="_blank">
	                        <button type="button" class="item-viewer-button filter-button" data-trip-domain="{{ trip_summary[0].TripDomain }}">
	                            <img src="static/images/photos.svg" />
	                        </button>
	                    </a>
	                {% endif %}

	                {% for item in trip_extension_reference_items %}
	                  {% if item.Date == day.Date %}
	                    {% if item.ExtensionType == "Diary" %}
	                      <button class="item-viewer-button dark-button" onclick="const img=document.getElementById('img_{{ loop.index }}');if(!img.src) img.src=img.dataset.src;document.getElementById('dlg_{{ loop.index }}').showModal();" type="button" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	                        D
	                      </button>
	                    {% elif item.ExtensionType == "Passport" %}
	                      <button class="item-viewer-button dark-button" onclick="const img=document.getElementById('img_{{ loop.index }}');if(!img.src) img.src=img.dataset.src;document.getElementById('dlg_{{ loop.index }}').showModal();" type="button" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">P</button>
	                    {% endif %}

	                    <dialog class="item-viewer" id="dlg_{{ loop.index }}" onclick="this.close();">
	                      <div class="item-viewer-filename">{{ item.Filepath | split(pat="/") | last }}</div>
	                      <img id="img_{{ loop.index }}" data-src="{{ item.Filepath }}" title="{{ item.Filepath }}">
	                    </dialog>
	                  {% endif %}
	                {% endfor %}
	              </div>
	              {{ day.Events }}
	          </div>
	                  
	          <div class="day-foot" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	            <div class="day-label"><span style="white-space: nowrap;"><div class="day-icon" data-trip-domain='{{ trip_summary[0].DomainAbbreviation }}'>{{ day.DayNumber }}</div> {% if translation.trip %}{{ translation.trip | get(key=day.Weekday | lower) }}{% else %}{{ day.Weekday }}{% endif %}</span> <span style="white-space: nowrap;">{{ day.Date }}</span></div>
	            &nbsp; 
	            <a class="acc-link" target="_blank" href="{{ settings.Other.ExternalMapProvider }}{{ day.AccommodationCoordinates }}" data-trip-domain="{{ trip_summary[0].DomainAbbreviation }}">
	                <div class="acc-icon" data-trip-domain='{{ trip_summary[0].DomainAbbreviation }}'></div>
	                <span class="acc-text">{{ day.Accommodation }} – {{ day.AccommodationCountryFlag }} {{ day.AccommodationCountry }} – {{ day.AccommodationCoordinates }} {{ day.AccommodationCoordinateAccuracy | default(value="") }}</span>
	            </a>
	          </div>
	        </div>
	      </div>
	    {% endfor %}
	  </div>
	  {% endif %}
     </div>
    </div>	
</div>
