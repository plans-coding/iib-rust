<div id="path-dataset">

  <script id="sql_output_data" type="application/json"></script>

  <div id="left-column">

    <details>
      <summary>{{ translation.dataset.general | default(value="General") }}</summary>
      <div class="details-content">
        <div class="clickable" data-sql="SELECT
            m.name AS table_name,
            p.name AS column_name
        FROM sqlite_master m
        JOIN pragma_table_info(m.name) p
        WHERE m.type='table' ORDER BY table_name;"
              onclick="load_code_editor(this.dataset.sql)">
          {{ translation.dataset.allFieldNames | default(value="All field names") }}
        </div>
      </div>
    </details>

    <details open>
      <summary>{{ translation.dataset.tables | default(value="Tables") }}</summary>
      <div class="details-content">
        {% for item in table_list %}
        <div class="clickable" onclick="load_code_editor('SELECT * FROM ' + this.innerHTML + ';');user_sql_execution();">
          {{ item.name }}
        </div>
        {% endfor %}
      </div>
    </details>

    <details>
      <summary>{{ translation.dataset.predefinedQueries | default(value="Pre-defined queries") }}</summary>
      <div class="details-content">
        {% for item in all.query_templates %}
        <div class="clickable" onclick="load_code_editor(get_predefined_query('{{ item }}'));">
          {{ item }}
        </div>
        {% endfor %}
      </div>
    </details>

    <details>
      <summary>{{ translation.dataset.customQueries | default(value="Custom queries") }}</summary>
      <div class="details-content" id="custom_queries">
        {% for query in stored_custom_queries %}
        <div class="clickable" onclick="custom_queries('{{ query.rowid }}');">
          {{ query.Name }}
        </div>
        {% endfor %}
      </div>
    </details>

  </div>

  <div id="right-column">

    <div class="top-controls">
      <button class="item-viewer-button black-button" onclick="document.getElementById('left-column').classList.toggle('hidden');">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-filetype-sql" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M14 4.5V14a2 2 0 0 1-2 2v-1a1 1 0 0 0 1-1V4.5h-2A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v9H2V2a2 2 0 0 1 2-2h5.5zM0 14.841a1.13 1.13 0 0 0 .401.823q.194.162.478.252c.284.09.411.091.665.091q.507 0 .858-.158.355-.159.54-.44a1.17 1.17 0 0 0 .187-.656q0-.336-.135-.56a1 1 0 0 0-.375-.357 2 2 0 0 0-.565-.21l-.621-.144a1 1 0 0 1-.405-.176.37.37 0 0 1-.143-.299q0-.234.184-.384.187-.152.513-.152.214 0 .37.068a.6.6 0 0 1 .245.181.56.56 0 0 1 .12.258h.75a1.1 1.1 0 0 0-.199-.566 1.2 1.2 0 0 0-.5-.41 1.8 1.8 0 0 0-.78-.152q-.44 0-.776.15-.337.149-.528.421-.19.273-.19.639 0 .302.123.524t.351.367q.229.143.54.213l.618.144q.31.073.462.193a.39.39 0 0 1 .153.325q0 .165-.085.29A.56.56 0 0 1 2 15.31q-.167.07-.413.07-.176 0-.32-.04a.8.8 0 0 1-.248-.115.58.58 0 0 1-.255-.384zm6.878 1.489-.507-.739q.264-.243.401-.6.138-.358.138-.806v-.501q0-.556-.208-.967a1.5 1.5 0 0 0-.589-.636q-.383-.225-.917-.225-.527 0-.914.225-.384.223-.592.636a2.14 2.14 0 0 0-.205.967v.5q0 .554.205.965.208.41.592.636a1.8 1.8 0 0 0 .914.222 1.8 1.8 0 0 0 .6-.1l.294.422h.788ZM4.262 14.2v-.522q0-.369.114-.63a.9.9 0 0 1 .325-.398.9.9 0 0 1 .495-.138q.288 0 .495.138a.9.9 0 0 1 .325.398q.115.261.115.63v.522q0 .246-.053.445-.053.196-.155.34l-.106-.14-.105-.147h-.733l.451.65a.6.6 0 0 1-.251.047.87.87 0 0 1-.487-.147.9.9 0 0 1-.32-.404 1.7 1.7 0 0 1-.11-.644m3.986 1.057h1.696v.674H7.457v-3.999h.79z"/>
        </svg>
      </button>

      {% set dataset_config = settings.Other.Dataset | split(pat=",") %}
      {% if dataset_config and dataset_config[0] == "Enabled" and dataset_config[1] %}
      <button class="item-viewer-button black-button" onclick="window.open('{{ dataset_config[1] }}', '_blank');">
        {{ translation.dataset.externalEditor | default(value="External editor") }}
        <!-- SVG omitted -->
      </button>
      {% endif %}

      <button class="item-viewer-button filter-button" id="run_query_button" onclick="user_sql_execution();">
        {{ translation.dataset.runQuery | default(value="Run query") }}
        <!-- SVG omitted -->
      </button>

      <div id="loading-overlay">
        <img src="static/images/frog.svg" class="rotate-animation" />
      </div>
    </div>

    <div id="editor-container">
      <textarea id="code_editor">SELECT * from bewa_Overview;</textarea>
    </div>

    <div id="sql-output">
      <div id="sql_output_table"></div>
    </div>

    <div id="cellViewer" contenteditable="true" onbeforeinput="return false"></div>

  </div>

</div>
