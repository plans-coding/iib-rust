<div id="path-dataset">

  <script id="sql_output_data" type="application/json"></script>

  <div id="left-column">

    <details>
      <summary>{{ translation.dataset.general | default(value="General") }}</summary>
      <div class="details-content">
        <div class="clickable" data-sql="SELECT
            m.name AS table_name,
            p.name AS column_name
        FROM sqlite_master m
        JOIN pragma_table_info(m.name) p
        WHERE m.type='table' ORDER BY table_name;"
              onclick="load_code_editor(this.dataset.sql)">
          {{ translation.dataset.allFieldNames | default(value="All field names") }}
        </div>
      </div>
    </details>

    <details open>
      <summary>{{ translation.dataset.tables | default(value="Tables") }}</summary>
      <div class="details-content">
        {% for item in table_list %}
        <div class="clickable" onclick="load_code_editor('SELECT * FROM ' + this.innerHTML + ';');user_sql_execution();">
          {{ item.name }}
        </div>
        {% endfor %}
      </div>
    </details>

    <details>
      <summary>{{ translation.dataset.predefinedQueries | default(value="Pre-defined queries") }}</summary>
      <div class="details-content">
        {% for item in all.query_templates %}
        <div class="clickable" onclick="load_code_editor(get_predefined_query('{{ item }}'));">
          {{ item }}
        </div>
        {% endfor %}
      </div>
    </details>

    <details>
      <summary>{{ translation.dataset.customQueries | default(value="Custom queries") }}</summary>
      <div class="details-content" id="custom_queries">
        {% for query in stored_custom_queries %}
        <div class="clickable" onclick="custom_queries('{{ query.rowid }}');">
          {{ query.Name }}
        </div>
        {% endfor %}
      </div>
    </details>

  </div>

  <div id="right-column">

    <div class="top-controls">
      <button class="black-button" onclick="document.getElementById('left-column').classList.toggle('hidden');">
        <!-- SVG omitted for brevity -->
      </button>

      {% set dataset_config = settings.Other.Dataset | split(pat=",") %}
      {% if dataset_config and dataset_config[0] == "Enabled" and dataset_config[1] %}
      <button class="black-button" onclick="window.open('{{ dataset_config[1] }}', '_blank');">
        {{ translation.dataset.externalEditor | default(value="External editor") }}
        <!-- SVG omitted -->
      </button>
      {% endif %}

      <button class="filter-button" id="run_query_button" onclick="user_sql_execution();">
        {{ translation.dataset.runQuery | default(value="Run query") }}
        <!-- SVG omitted -->
      </button>

      <div id="loading-overlay">
        <img src="static/images/frog.svg" class="rotate-animation" />
      </div>
    </div>

    <div id="editor-container">
      <textarea id="code_editor">SELECT * from bewa_Overview;</textarea>
    </div>

    <div id="sql-output">
      <div id="sql_output_table"></div>
    </div>

    <div id="cellViewer" contenteditable="true" onbeforeinput="return false"></div>

  </div>

</div>